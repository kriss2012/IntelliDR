# IntelliDR Environment Configuration
# SIH26168 - Smart Vehicles | Indian Space Research Organisation (ISRO)
# Team: Logic Legend2 (Team ID: 170889)

# System & Server Config
INTELLIDR_ENV=production
INTELLIDR_HOST=0.0.0.0
INTELLIDR_PORT=8000
INTELLIDR_UDP_PORT=5555

# Navigation Engine Parameters
TARGET_IMU_RATE_HZ=100.0
ENABLE_MAP_MATCHING=true
REFERENCE_LATITUDE=19.0760
REFERENCE_LONGITUDE=72.8777
REFERENCE_ALTITUDE=14.0

# GNSS Outage Detection Thresholds
OUTAGE_TIMEOUT_DEGRADED_S=1.5
OUTAGE_TIMEOUT_LOST_S=3.0
MAX_INNOVATION_JUMP_M=40.0

# Telemetry & Logging
LOG_LEVEL=INFO
ENABLE_DEBUG_DUMP=false
